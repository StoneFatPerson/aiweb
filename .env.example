# ============================================================
# 环境变量模板（.env.example）
# ============================================================
#
# 【重要】这个文件只是「清单」，用来告诉别人需要配置哪些变量。
# Spring Boot / Java 不会自动读取 .env 文件。
# 真正的密钥要配到 Windows 系统环境变量里（或用 IDEA 的运行配置）。
#
# 用法：
#   1. 复制本文件为 .env（可选，仅作本地备忘；.env 已在 .gitignore 中被忽略）
#   2. 真正生效仍然要去：Win+S → 编辑系统环境变量 → 用户变量 → 新建
#   3. 改完必须重启 IntelliJ IDEA
#
# 安全：本文件不要填真实密钥，也不要提交任何真实密钥。
# ============================================================

# 智谱开放平台 API Key —— 必填
# 获取地址：https://open.bigmodel.cn → 控制台 → API Keys
# 缺失后果：程序启动失败，并在控制台给出中文提示
ZHIPU_API_KEY=your_zhipu_api_key_here

# MySQL 密码 —— 必填
# 缺失后果：以空密码尝试连接 MySQL，启动时会打印警告
DB_PASSWORD=your_mysql_password_here

# MySQL 用户名 —— 选填，默认 aiweb_app（专用低权限账号）
# 生产环境不要用 root。建号示例（只授予 aiweb 库的增删改查与建表权限）：
#   CREATE USER 'aiweb_app'@'localhost' IDENTIFIED BY '你的密码';
#   GRANT SELECT,INSERT,UPDATE,DELETE,CREATE,ALTER,INDEX,REFERENCES ON aiweb.* TO 'aiweb_app'@'localhost';
DB_USERNAME=aiweb_app

# MySQL 是否启用 SSL —— 选填，默认 false；生产环境建议 true
DB_USE_SSL=false

# 允许跨域的前端来源（逗号分隔）—— 选填
# 默认 http://localhost:5173,http://localhost:8080；部署时改成你的站点域名
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
